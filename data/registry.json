    {
      "id": "pinyon-linux",
      "name": "Pinyon Shift Linux · MASELKO-95",
      "repo": "MASELKO-95/pinyon-shift-Native-Linux-unofficial",
      "platform": "xbox360",
      "kind": "recompile",
      "asset_pattern": "PinyonShift-Linux-*.tar.gz",
      "exclude_pattern": "*source*",
      "executable": "PinyonShift.sh",
      "adapter": "pinyon-legacy",
      "verified": true,
      "archived": true,
      "channel": "preview",
      "supported": false,
      "auto_update": false,
      "guide": "https://github.com/MASELKO-95/pinyon-shift-Native-Linux-unofficial#readme",
      "note": "Pre-release — niewspierana wersja MASELKO-95. Archiwalny, niezależny port Linux dostępny jako alternatywa. Grę budujesz z własnego, obsługiwanego ISO.",
      "assets_by_system": {
        "linux": "PinyonShift-Linux-*.tar.gz"
      },
      "executables_by_system": {
        "linux": "PinyonShift.sh"
      },
      "technologies": [
        "static-recompilation"
      ]
    },
    {
      "id": "pinyon",
      "name": "Pinyon Shift",
      "repo": "arcanite24/pinyon-shift",
      "platform": "xbox360",
      "kind": "recompile",
      "asset_pattern": "PinyonShift-Launcher-linux-x86_64.tar.gz",
      "executable": "PinyonShiftLauncher",
      "adapter": "pinyon",
      "verified": true,
      "channel": "final",
      "supported": true,
      "guide": "https://github.com/arcanite24/pinyon-shift/blob/main/docs/LINUX.md",
      "note": "Pinyon Shift: wspólny panel w RE:COPILE wyboru własnego ISO lub folderu gry, weryfikacji, budowania i uruchamiania bez osobnego okna launchera. Silnik i narzędzia pochodzą z oryginalnego arcanite24/pinyon-shift; prawa i autorzy pozostają oryginalne. Pobranie narzędzi nie oznacza gotowej gry. Przygotowanie uruchamia oryginalny workflow projektu i może pobrać kompilator oraz zależności. Obsługiwane dane gry i stan zgodności sprawdź w README. Linux: pakiet narzędzi 0.6.0 jest udostępniony w Releases RE:COPILE, z przypiętymi oryginalnymi źródłami i licencją BSD. Pliki gry i kompilacja wykonywana z nich pozostają lokalne.",
      "assets_by_system": {
        "linux": "PinyonShift-0.6.0-Recopile-linux-x86_64.tar.gz",
        "windows": "PinyonShift-Launcher.zip"
      },
      "executables_by_system": {
        "linux": "PinyonShift-Recopile.py",
        "windows": "PinyonShiftLauncher.exe"
      },
      "technologies": [
        "static-recompilation"
      ],
      "repos_by_system": {
        "linux": "MASELKO-95/recopile"
      },
      "release_tags_by_system": {
        "linux": "pinyon-v0.6.0-recopile.1"
      },
      "documentation_repo": "arcanite24/pinyon-shift",
      "documentation_ref": "9331e453e9850d0fcc1c1606dee95db834a9d317"
    },
